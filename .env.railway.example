# Railway Environment Variables Example
# These variables are automatically set by Railway for managed services.
# Copy this file to .env.railway for local testing with Railway-like configuration.

# =============================================================================
# RAILWAY AUTO-INJECTED VARIABLES
# These are automatically provided by Railway when you connect services:
# =============================================================================

# PostgreSQL (Railway Managed)
# Railway automatically sets this when you add a PostgreSQL service
DATABASE_URL=postgresql://user:password@host:port/database

# Redis (Railway Managed)
# Railway automatically sets this when you add a Redis service
REDIS_URL=redis://default:password@host:port

# Port (Railway Managed)
# Railway automatically assigns a port for your service
PORT=8000

# Railway Environment
# Automatically set by Railway (production, staging, etc.)
RAILWAY_ENVIRONMENT=production

# =============================================================================
# APPLICATION CONFIGURATION
# Set these in Railway dashboard under Variables:
# =============================================================================

# Application
PROJECT_NAME=AutoCognitix
DEBUG=false
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Security (REQUIRED - Set strong values in Railway!)
SECRET_KEY=your-production-secret-key-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings for httpOnly JWT storage
# REQUIRED for cross-site production: frontend and backend run on different
# *.up.railway.app domains, and the auth flow is 100% httpOnly-cookie based.
# Cross-site cookies must be SameSite=None + Secure or the browser drops them,
# logging users out right after login. (Same-origin/local dev: lax + false.)
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# CORS Origins (comma-separated for multiple origins)
BACKEND_CORS_ORIGINS=https://your-frontend-domain.railway.app,https://your-custom-domain.com

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Neo4j (if using external Neo4j service)
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Qdrant (if using external Qdrant service)
QDRANT_HOST=your-qdrant-host
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Unified huBERT collection holding all DTC/complaint/recall vectors (default shown)
# QDRANT_UNIFIED_COLLECTION=autocognitix

# =============================================================================
# API KEYS (Set in Railway dashboard)
# =============================================================================

# External APIs
NHTSA_API_BASE_URL=https://vpic.nhtsa.dot.gov/api
YOUTUBE_API_KEY=
CARMD_API_KEY=
CARMD_PARTNER_TOKEN=
CARAPI_API_KEY=

# LLM Configuration
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Hungarian NLP
HUBERT_MODEL=SZTAKI-HLT/hubert-base-cc
# PINNED COMMIT SHA — never "main" here. As a Railway service variable this
# OVERRIDES the pinned default in settings.HUBERT_REVISION, so a "main" would
# reintroduce exactly the drift the pin prevents: the ~54,000 vectors in Qdrant
# were produced from these weights. Changing it means regenerating
# backend/tests/fixtures/hubert_reference_vectors.json and reindexing Qdrant.
HUBERT_REVISION=028baac7feb87a7b2f042bbdaa5deec6513c6060
EMBEDDING_DIMENSION=768
HUSPACY_MODEL=hu_core_news_lg

# Embedding backend. The production image ships the exported ONNX graph and sets
# EMBEDDING_BACKEND=onnx itself; leave this unset unless you are turning
# semantic search OFF (EMBEDDING_BACKEND=disabled). NOTE: "torch" does NOT work
# in the production image — torch is deliberately not installed there — so
# "disabled" is the kill switch, not a backend switch.
# EMBEDDING_BACKEND=onnx
# HUBERT_ONNX_PATH=/app/models/hubert_fp32.onnx
# HUBERT_VOCAB_PATH=/app/models/vocab.txt
# ONNX Runtime intra-op threads per session (one session per web worker).
EMBEDDING_ORT_THREADS=1

# Gunicorn worker count. A VARIABLE on purpose: each worker holds its own ~595 MB
# ONNX model, so 2 workers need ~1.2 GB steady and ~2 GB while both cold-load.
# restartPolicyMaxRetries = 3 means three OOM kills stop the restarts for good,
# and at that point a rebuild is not a recovery option — this is.
# See docs/RAILWAY_DEPLOYMENT.md.
WEB_CONCURRENCY=2

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
